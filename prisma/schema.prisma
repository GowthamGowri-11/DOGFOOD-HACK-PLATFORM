generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String             @id @default(uuid())
  email           String             @unique
  passwordHash    String
  fullName        String
  avatarUrl       String?
  bio             String?
  githubUrl       String?
  linkedinUrl     String?
  role            RoleType           @default(PARTICIPANT)
  isActive        Boolean            @default(true)
  emailVerified   Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  attendance      AttendanceRecord[]
  auditLogs       AuditLog[]
  certificates    Certificate[]
  comments        Comment[]
  evaluations     Evaluation[]
  organizedEvents Hackathon[]        @relation("OrganizerHackathons")
  judges          Judge[]
  notifications   Notification[]
  registrations   Registration[]
  teamInvitesSent TeamInvite[]       @relation("InvitedByUser")
  teamInvitesRcvd TeamInvite[]       @relation("InvitedUser")
  teamMembers     TeamMember[]
  votes           Vote[]
  judgeEditRequests EvaluationEditRequest[] @relation("JudgeUserEditRequests")

  @@index([email])
  @@index([role])
}

model Hackathon {
  id                  String               @id @default(uuid())
  slug                String               @unique
  title               String
  tagline             String?
  description         String
  bannerUrl           String?
  logoUrl             String?
  organizationName    String
  organizerId         String
  status              EventStatus          @default(DRAFT)
  progressionMode     ProgressionMode      @default(OVERALL_PERFORMANCE)
  currentRoundNumber  Int                  @default(1)
  minTeamSize         Int                  @default(1)
  maxTeamSize         Int                  @default(4)
  regStartTime        DateTime
  regEndTime          DateTime
  eventStartTime      DateTime
  eventEndTime        DateTime
  subStartTime        DateTime
  subEndTime          DateTime
  judgingStartTime    DateTime
  judgingEndTime      DateTime
  resultsPublishedAt  DateTime?
  isVotingEnabled     Boolean              @default(false)
  votingStartTime     DateTime?
  votingEndTime       DateTime?
  eligibilityRules    String?
  rulesAndGuidelines  String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  aiJuryRuns          AIJuryRun[]
  attendanceSessions  AttendanceSession[]
  auditLogs           AuditLog[]
  certificates        Certificate[]
  organizer           User                 @relation("OrganizerHackathons", fields: [organizerId], references: [id])
  judges              Judge[]
  prizes              Prize[]
  problemStatements   ProblemStatement[]
  projects            Project[]
  registrations       Registration[]
  results             Result[]
  rounds              Round[]
  roundResults        RoundResult[]
  rubrics             Rubric[]
  scoreNormalizations ScoreNormalization[]
  teams               Team[]
  tracks              Track[]
  editRequests        EvaluationEditRequest[]

  @@index([slug])
  @@index([status])
  @@index([organizerId])
}

model Track {
  id                String             @id @default(uuid())
  hackathonId       String
  title             String
  slug              String
  description       String?
  colorHex          String?            @default("#3B82F6")
  displayOrder      Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  problemStatements ProblemStatement[]
  projects          Project[]
  hackathon         Hackathon          @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  @@unique([hackathonId, slug])
  @@index([hackathonId])
}

model ProblemStatement {
  id              String    @id @default(uuid())
  hackathonId     String
  trackId         String
  code            String
  title           String
  description     String
  challengeDocUrl String?
  isPublic        Boolean   @default(true)
  displayOrder    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  hackathon       Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  track           Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)
  projects        Project[]

  @@unique([hackathonId, code])
  @@index([trackId])
  @@index([hackathonId])
}

model Prize {
  id          String    @id @default(uuid())
  hackathonId String
  title       String
  category    String?
  amount      Decimal   @db.Decimal(10, 2)
  currency    String    @default("USD")
  rankOrder   Int       @default(1)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  @@index([hackathonId])
}

model Registration {
  id            String             @id @default(uuid())
  hackathonId   String
  userId        String
  status        RegistrationStatus @default(APPROVED)
  customAnswers Json?
  checkedIn     Boolean            @default(false)
  checkedInAt   DateTime?
  registeredAt  DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  hackathon     Hackathon          @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hackathonId, userId])
  @@index([hackathonId, status])
  @@index([userId])
}

model Team {
  id          String       @id @default(uuid())
  hackathonId String
  name        String
  inviteCode  String       @unique
  leaderId    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  progressionStatus TeamProgressionStatus @default(ELIGIBLE)
  highestRound      Int                   @default(1)
  project     Project?
  hackathon   Hackathon    @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  invites     TeamInvite[]
  members     TeamMember[]
  roundResults RoundResult[]

  @@unique([hackathonId, name])
  @@index([hackathonId])
  @@index([inviteCode])
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String
  userId   String
  isLeader Boolean  @default(false)
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId])
}

model TeamInvite {
  id            String           @id @default(uuid())
  teamId        String
  invitedEmail  String
  invitedUserId String?
  invitedById   String
  status        TeamInviteStatus @default(PENDING)
  token         String           @unique
  expiresAt     DateTime
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  invitedBy     User             @relation("InvitedByUser", fields: [invitedById], references: [id])
  invitedUser   User?            @relation("InvitedUser", fields: [invitedUserId], references: [id])
  team          Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([invitedEmail])
  @@index([token])
}

model Project {
  id               String            @id @default(uuid())
  hackathonId      String
  teamId           String            @unique
  trackId          String
  problemId        String
  title            String
  slug             String
  tagline          String?
  description      String
  thumbnailUrl     String?
  repoUrl          String
  demoUrl          String?
  videoUrl         String?
  documentationUrl String?
  techStack        String[]
  isPublished      Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  aiJuryRuns       AIJuryRun[]
  comments         Comment[]
  evaluations      Evaluation[]
  judgeAssignments JudgeAssignment[]
  hackathon        Hackathon         @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  problemStatement ProblemStatement  @relation(fields: [problemId], references: [id])
  team             Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  track            Track             @relation(fields: [trackId], references: [id])
  result           Result?
  submissions      Submission[]
  votes            Vote[]
  editRequests     EvaluationEditRequest[]
  roundResults     RoundResult[]

  @@unique([hackathonId, slug])
  @@index([hackathonId])
  @@index([trackId])
  @@index([problemId])
}

model Submission {
  id              String           @id @default(uuid())
  projectId       String
  versionNumber   Int              @default(1)
  status          SubmissionStatus @default(DRAFT)
  payloadSnapshot Json
  submittedAt     DateTime?
  lockedAt        DateTime?
  createdById     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, versionNumber])
  @@index([status])
}

model Judge {
  id              String            @id @default(uuid())
  hackathonId     String
  userId          String
  expertiseTracks String[]
  maxWorkload     Int               @default(10)
  isActive        Boolean           @default(true)
  conflictTeamIds String[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  evaluations     Evaluation[]
  hackathon       Hackathon         @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments     JudgeAssignment[]
  editRequests    EvaluationEditRequest[]

  @@unique([hackathonId, userId])
  @@index([hackathonId])
  @@index([userId])
}

model JudgeAssignment {
  id          String           @id @default(uuid())
  judgeId     String
  projectId   String
  roundId     String?
  subRoundId  String?
  status      AssignmentStatus @default(ASSIGNED)
  assignedAt  DateTime         @default(now())
  completedAt DateTime?
  evaluation  Evaluation?
  judge       Judge            @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([judgeId, projectId])
  @@index([judgeId, status])
  @@index([projectId])
  @@index([roundId])
}

model Rubric {
  id          String            @id @default(uuid())
  hackathonId String
  version     Int               @default(1)
  name        String            @default("Default Rubric")
  isCurrent   Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  aiJuryRuns  AIJuryRun[]
  evaluations Evaluation[]
  hackathon   Hackathon         @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  criteria    RubricCriterion[]

  @@index([hackathonId, isCurrent])
}

model RubricCriterion {
  id               String            @id @default(uuid())
  rubricId         String
  title            String
  description      String
  weightPercentage Float
  maxScore         Float             @default(100)
  displayOrder     Int               @default(0)
  requiredFeedback Boolean           @default(true)
  aiScores         AIScore[]
  evaluationScores EvaluationScore[]
  rubric           Rubric            @relation(fields: [rubricId], references: [id], onDelete: Cascade)

  @@index([rubricId])
}

model Evaluation {
  id               String                  @id @default(uuid())
  assignmentId     String?                 @unique
  judgeId          String
  judgeUserId      String
  projectId        String
  rubricId         String
  roundId          String?
  subRoundId       String?
  status           EvaluationStatus        @default(DRAFT)
  rawScoreSum      Float                   @default(0)
  weightedScore    Float                   @default(0)
  version          Int                     @default(1)
  encryptedPayload String?
  markHistory      Json?
  prosComment      String?
  consComment      String?
  suggestions      String?
  privateNotes     String?
  submittedAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  aiComparisons    AIHumanComparison[]
  assignment       JudgeAssignment?        @relation(fields: [assignmentId], references: [id])
  judge            Judge                   @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  judgeUser        User                    @relation(fields: [judgeUserId], references: [id])
  project          Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rubric           Rubric                  @relation(fields: [rubricId], references: [id])
  scores           EvaluationScore[]
  editRequests     EvaluationEditRequest[]

  @@unique([judgeId, projectId])
  @@index([projectId])
  @@index([judgeId])
  @@index([status])
  @@index([roundId])
}

model EvaluationScore {
  id            String          @id @default(uuid())
  evaluationId  String
  criterionId   String
  rawScore      Float
  originalScore Float?
  feedback      String?
  criterion     RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  evaluation    Evaluation      @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, criterionId])
  @@index([criterionId])
}

model ScoreNormalization {
  id          String              @id @default(uuid())
  hackathonId String
  method      NormalizationMethod @default(Z_SCORE)
  parameters  Json?
  version     Int                 @default(1)
  executedAt  DateTime            @default(now())
  results     Result[]
  hackathon   Hackathon           @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  @@index([hackathonId, version])
}

model Result {
  id              String              @id @default(uuid())
  hackathonId     String
  projectId       String              @unique
  normalizationId String?
  rawAverageScore Float
  normalizedScore Float
  finalScore      Float
  rank            Int
  awardCategory   String?
  isWinner        Boolean             @default(false)
  isPublished     Boolean             @default(false)
  publishedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  hackathon       Hackathon           @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  normalization   ScoreNormalization? @relation(fields: [normalizationId], references: [id])
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([hackathonId, rank])
  @@index([hackathonId, isPublished])
}

model Vote {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  ipHash    String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  content   String
  isFlagged Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
}

model AttendanceSession {
  id          String             @id @default(uuid())
  hackathonId String
  title       String
  sessionCode String             @unique
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  records     AttendanceRecord[]
  hackathon   Hackathon          @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  @@index([hackathonId])
}

model AttendanceRecord {
  id          String            @id @default(uuid())
  sessionId   String
  userId      String
  checkedInAt DateTime          @default(now())
  method      String            @default("QR_CODE")
  session     AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
}

model Certificate {
  id               String            @id @default(uuid())
  hackathonId      String
  userId           String
  type             CertificateType   @default(PARTICIPANT)
  verificationCode String            @unique
  status           CertificateStatus @default(ISSUED)
  title            String
  recipientName    String
  awardDetail      String?
  issuedAt         DateTime          @default(now())
  revokedAt        DateTime?
  revocationReason String?
  hackathon        Hackathon         @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verificationCode])
  @@index([hackathonId, userId])
}

model AIModelVersion {
  id               String      @id @default(uuid())
  versionTag       String      @unique
  modelProvider    String      @default("anthropic")
  modelName        String      @default("claude-3-7-sonnet")
  temperature      Float       @default(0.2)
  systemPromptHash String
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  juryRuns         AIJuryRun[]
}

model PromptVersion {
  id             String      @id @default(uuid())
  versionTag     String      @unique
  promptTemplate String
  evidenceRules  String
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  juryRuns       AIJuryRun[]
}

model AIJuryRun {
  id                 String              @id @default(uuid())
  hackathonId        String
  projectId          String
  rubricId           String
  modelVersionId     String
  promptVersionId    String
  overallScore       Float
  confidenceScore    Float
  rawAnalysis        Json
  summaryFeedback    String
  executionLatencyMs Int
  createdAt          DateTime            @default(now())
  evidence           AIEvidence[]
  comparisons        AIHumanComparison[]
  hackathon          Hackathon           @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  modelVersion       AIModelVersion      @relation(fields: [modelVersionId], references: [id])
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  promptVersion      PromptVersion       @relation(fields: [promptVersionId], references: [id])
  rubric             Rubric              @relation(fields: [rubricId], references: [id])
  scores             AIScore[]

  @@index([projectId])
  @@index([hackathonId])
}

model AIEvidence {
  id              String    @id @default(uuid())
  runId           String
  category        String
  finding         String
  snippet         String?
  sourceLocation  String?
  confidenceLevel Float     @default(1.0)
  aiRun           AIJuryRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model AIScore {
  id          String          @id @default(uuid())
  runId       String
  criterionId String
  score       Float
  confidence  Float
  feedback    String?
  criterion   RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  aiRun       AIJuryRun       @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, criterionId])
  @@index([criterionId])
}

model AIHumanComparison {
  id                String            @id @default(uuid())
  aiRunId           String
  evaluationId      String
  criterionId       String
  aiScore           Float
  humanScore        Float
  scoreDifference   Float
  absoluteError     Float
  confidence        Float
  agreementCategory String
  createdAt         DateTime          @default(now())
  aiRun             AIJuryRun         @relation(fields: [aiRunId], references: [id], onDelete: Cascade)
  humanEvaluation   Evaluation        @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  trainingExamples  TrainingExample[]

  @@index([aiRunId])
  @@index([evaluationId])
  @@index([criterionId])
}

model DatasetVersion {
  id               String            @id @default(uuid())
  versionTag       String            @unique
  description      String
  sampleCount      Int               @default(0)
  trainTestSplit   Float             @default(0.8)
  createdAt        DateTime          @default(now())
  calibrationRuns  CalibrationRun[]
  trainingExamples TrainingExample[]
}

model TrainingExample {
  id               String            @id @default(uuid())
  datasetId        String
  comparisonId     String
  isValidationSet  Boolean           @default(false)
  inputFeatures    Json
  targetHumanScore Float
  createdAt        DateTime          @default(now())
  comparison       AIHumanComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  dataset          DatasetVersion    @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId, isValidationSet])
}

model CalibrationRun {
  id                 String         @id @default(uuid())
  datasetId          String
  calibrationVersion String
  maeBefore          Float
  maeAfter           Float
  rmseBefore         Float
  rmseAfter          Float
  correlationBefore  Float
  correlationAfter   Float
  hyperparameters    Json?
  status             String         @default("COMPLETED")
  executedAt         DateTime       @default(now())
  dataset            DatasetVersion @relation(fields: [datasetId], references: [id])

  @@index([datasetId])
}

model AuditLog {
  id          String     @id @default(uuid())
  userId      String?
  hackathonId String?
  action      String
  entityType  String
  entityId    String
  beforeState Json?
  afterState  Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime   @default(now())
  hackathon   Hackathon? @relation(fields: [hackathonId], references: [id])
  user        User?      @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([entityType, entityId])
  @@index([hackathonId])
  @@index([userId])
}

model Notification {
  id          String    @id @default(uuid())
  userId      String
  title       String
  message     String
  linkUrl     String?
  type        String?
  entityType  String?
  entityId    String?
  hackathonId String?
  roundId     String?
  subRoundId  String?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([hackathonId])
}

model EvaluationEditRequest {
  id                String            @id @default(uuid())
  evaluationId      String
  judgeId           String
  judgeUserId       String
  hackathonId       String
  roundId           String?
  subRoundId        String?
  teamId            String
  projectId         String
  criterionId       String
  criterionTitle    String
  oldScore          Float
  requestedScore    Float
  reason            String
  status            EditRequestStatus @default(PENDING)
  authCodeHash      String?
  authCodeMasked    String?
  authCodePlain     String?
  authCodeExpiresAt DateTime?
  isCodeUsed        Boolean           @default(false)
  usedAt            DateTime?
  approvedById      String?
  approvedByType    String?
  approvedAt        DateTime?
  rejectedById      String?
  rejectedReason    String?
  rejectedAt        DateTime?
  executedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  evaluation        Evaluation        @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  judge             Judge             @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  judgeUser         User              @relation("JudgeUserEditRequests", fields: [judgeUserId], references: [id])
  hackathon         Hackathon         @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([hackathonId, status])
  @@index([judgeUserId, status])
  @@index([evaluationId])
  @@index([projectId])
}

model AuthorizationCodeRegistry {
  code          String    @id
  editRequestId String    @unique
  isUsed        Boolean   @default(false)
  issuedAt      DateTime  @default(now())
  expiresAt     DateTime
  usedAt        DateTime?

  @@index([isUsed, expiresAt])
}

enum EditRequestStatus {
  PENDING
  APPROVED
  CODE_ISSUED
  REJECTED
  EXPIRED
  EXECUTED
}

enum RoleType {
  ADMIN
  ORGANIZER
  JUDGE
  PARTICIPANT
}

enum EventStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  EVENT_ACTIVE
  SUBMISSION_OPEN
  SUBMISSION_CLOSED
  JUDGING
  RESULTS_PENDING
  RESULTS_PUBLISHED
  COMPLETED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
  CANCELLED
}

enum TeamInviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum SubmissionStatus {
  DRAFT
  VALIDATED
  SUBMITTED
  LOCKED
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  DECLINED
  CONFLICT_FLAGGED
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
  FLAGGED
  ARCHIVED
}

enum NormalizationMethod {
  Z_SCORE
  MIN_MAX
  PERCENTILE_RANK
  TRIMMED_MEAN
  BAYESIAN_MEAN
}

enum CertificateType {
  PARTICIPANT
  WINNER
  RUNNER_UP
  SPECIAL_MENTION
  JUDGE
  ORGANIZER
}

enum CertificateStatus {
  DRAFT
  ISSUED
  REVOKED
}

enum ProgressionMode {
  SELECTION_BASED
  OVERALL_PERFORMANCE
}

enum TeamProgressionStatus {
  ELIGIBLE
  ADVANCED
  ELIMINATED
  DISQUALIFIED
}

enum RoundStatus {
  DRAFT
  REGISTRATION
  ACTIVE
  EVALUATION
  RESULT_PENDING
  RESULT_PUBLISHED
  COMPLETED
}

model Round {
  id                 String            @id @default(uuid())
  hackathonId        String
  roundNumber        Int               @default(1)
  name               String
  roundType          String            @default("HACKATHON")
  status             RoundStatus       @default(ACTIVE)
  startDate          DateTime?
  endDate            DateTime?
  submissionDeadline DateTime?
  selectionCount     Int?
  maxTeamsAllowed    Int?
  isFinal            Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  hackathon          Hackathon         @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  roundResults       RoundResult[]

  @@unique([hackathonId, roundNumber])
  @@index([hackathonId])
}

model RoundResult {
  id                String                @id @default(uuid())
  hackathonId       String
  roundNumber       Int
  roundId           String?
  projectId         String?
  teamId            String
  rawAverageScore   Float
  normalizedScore   Float
  finalScore        Float
  rank              Int
  progressionStatus TeamProgressionStatus @default(ELIGIBLE)
  isPublished       Boolean               @default(false)
  publishedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  hackathon         Hackathon             @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  project           Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  round             Round?                @relation(fields: [roundId], references: [id], onDelete: SetNull)
  team              Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([roundNumber, teamId])
  @@index([hackathonId, roundNumber])
  @@index([teamId])
  @@index([roundId])
}

