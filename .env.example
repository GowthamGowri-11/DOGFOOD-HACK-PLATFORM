# Neon PostgreSQL Database Connection
# Connection Pooling URL (for Next.js App Router / Serverless)
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Direct URL (for Prisma migrations)
DIRECT_URL="postgresql://neondb_owner:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication Secrets
JWT_SECRET="super-secret-jwt-key-change-this-in-production-min-32-chars"
SESSION_EXPIRY="7d"

# App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Jury & LLM Configuration
AI_JURY_API_KEY="your-llm-api-key-here"
AI_JURY_MODEL="claude-3-7-sonnet"
AI_JURY_TEMPERATURE="0.2"

# Node Environment
NODE_ENV="development"
